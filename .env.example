# --- Admin Alerts ---
BOOKING_ALERT_EMAIL=anoopbr2002@gmail.com
BOOKING_ALERT_PHONE=+918867572830

# --- SMTP Outbound Email Settings (Gmail) ---
# To send emails through Gmail:
# 1. Open Google Account (https://myaccount.google.com)
# 2. Go to "Security" -> Enable "2-Step Verification"
# 3. Search for "App Passwords" (or visit https://myaccount.google.com/apppasswords)
# 4. Create an app password named "HouseKeep"
# 5. Paste the 16-character code below as HOUSEKEEP_SMTP_PASSWORD
HOUSEKEEP_SMTP_HOST=smtp.gmail.com
HOUSEKEEP_SMTP_PORT=587
HOUSEKEEP_SMTP_USERNAME=anoopbr2002@gmail.com
HOUSEKEEP_SMTP_PASSWORD=your_16_digit_gmail_app_password
HOUSEKEEP_SMTP_FROM=anoopbr2002@gmail.com

# --- Optional Twilio SMS Notifications ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Admin Token (for marking bookings completed) ---
HOUSEKEEP_ADMIN_TOKEN=housekeep-admin-secret-token
